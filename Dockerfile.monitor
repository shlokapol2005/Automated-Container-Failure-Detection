# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.monitor
# Container image for the health monitor / auto-recovery daemon
#
# WHY DOCKER PYTHON SDK instead of docker CLI:
#   The docker.io apt package is unreliable on slim Python base images and
#   requires the full docker daemon binary stack. The Docker Python SDK
#   (`docker` package) communicates with the Docker daemon directly via
#   the mounted socket (/var/run/docker.sock) using HTTP — no binary needed.
#   This is the standard, production-grade pattern for sidecar containers
#   that need to control sibling containers.
#
# AIOps: ai_diagnosis.py calls Google Gemini via plain HTTPS (no extra package)
#   or Claude via the `anthropic` SDK, on a background thread only;
#   recovery never depends on it.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /monitor

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install Docker Python SDK (socket, no CLI binary needed) + Anthropic SDK (AIOps)
COPY monitor/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY monitor/monitor.py monitor/ai_diagnosis.py ./

CMD ["python", "-u", "monitor.py"]
