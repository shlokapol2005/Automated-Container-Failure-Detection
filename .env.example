# Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord Webhook ──────────────────────────────────────────────────────────
# Create a webhook in your Discord server:
#   Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── AIOps Incident Diagnosis — OPTIONAL ──────────────────────────────────────
# FREE option: Google Gemini. Get a key (no credit card) at
#   https://aistudio.google.com → Get API key
# Leave all keys empty to disable AI diagnosis; recovery + standard alerts work either way.
# Logs are redacted (keys, tokens, webhook URLs, passwords, e-mails) before sending.
GEMINI_API_KEY=
# Paid alternative — Claude API (https://platform.claude.com → API Keys):
ANTHROPIC_API_KEY=
# AI_PROVIDER: gemini | claude — leave empty to use whichever key is set
AI_PROVIDER=
AI_DIAGNOSIS=true                           # Master switch: true / false
# AI_MODEL: leave empty for the default (gemini-flash-latest / claude-opus-5-5)
AI_MODEL=
AI_EFFORT=low                               # Claude only: low | medium | high
AI_TIMEOUT=30                               # Seconds before the AI call is abandoned
AI_LOG_LINES=100                            # Container log lines sent as evidence

# ── Monitor Configuration ─────────────────────────────────────────────────────
HEALTH_URL=http://localhost:5000/health     # Overridden to http://flask-app:5000/health inside Docker
CONTAINER_NAME=flask-devops-app
CHECK_INTERVAL=10
RECOVERY_TIMEOUT=60
MAX_RESTARTS=5                              # Restarts before escalation alert is sent

# ── Docker Compose ────────────────────────────────────────────────────────────
# If pulling from Docker Hub set this to your pushed image:
# DOCKER_IMAGE=yourdockerhubusername/flask-devops-app:latest
DOCKER_IMAGE=flask-devops-app:local

# ── Grafana ────────────────────────────────────────────────────────────────────
# Grafana dashboard login password (username is always "admin")
GRAFANA_PASSWORD=admin
