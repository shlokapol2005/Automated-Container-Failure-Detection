# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.monitor
# Container image for the health monitor / auto-recovery daemon
#
# WHY A SEPARATE DOCKERFILE?
#   The monitor needs the Docker CLI to issue `docker restart` commands.
#   Mounting /var/run/docker.sock gives it access to the host Docker daemon,
#   and installing docker.io provides the CLI binary inside the container.
#   This pattern is commonly used for sidecar monitoring containers.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# Install Docker CLI (needed to run `docker restart <container>` from inside
# the container via the mounted Docker socket)
RUN apt-get update && \
    apt-get install -y --no-install-recommends docker.io && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /monitor

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY monitor/monitor.py .

CMD ["python", "-u", "monitor.py"]
